{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false",
        "EXPO_PUBLIC_TEST_AUTO_GUEST": "true"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_TEST_AUTO_GUEST": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
