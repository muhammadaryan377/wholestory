# Copy this file to .env and fill in the values from Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Where you put guest-web/index.html (step 4 in README). Guests' QR codes point here.
EXPO_PUBLIC_GUEST_PAGE_URL=https://YOUR-SITE.netlify.app
EXPO_PUBLIC_PRIVACY_URL=https://wholestory.app/privacy
EXPO_PUBLIC_TERMS_URL=https://wholestory.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=you@example.com

# Payments are off for the TestFlight test. To turn them on later, see README 'Turning on payments'.
EXPO_PUBLIC_PAYMENTS_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Crash reporting stays disabled until the client supplies their Sentry DSN.
EXPO_PUBLIC_SENTRY_DSN=
# Set SENTRY_ORG, SENTRY_PROJECT and secret SENTRY_AUTH_TOKEN in EAS for source maps.
